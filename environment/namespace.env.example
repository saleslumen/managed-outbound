# Copy to environment/{namespaceId}.env for node scripts/install.mjs --namespace {id}.
# <KEY>_MARKETPLACE_APP_ID is the marketplace app id. The installer reads the permission digest and the API-key connection from that app, creates the namespace installation, and rewrites the bare key to installations/{id}.
# When the app declares one installation API-key connection, <KEY>_API_KEY is written there. Saleslumen Emails declares no connection.
# airtable/.env still holds AIRTABLE_PAT and AIRTABLE_BASE_ID for the base. AIRTABLE_API_KEY here is the marketplace credential.
# The agent never reads this file.

AIRTABLE_MARKETPLACE_APP_ID=
AIRTABLE_API_KEY=
DYNADOT_MARKETPLACE_APP_ID=
DYNADOT_API_KEY=
OPENROUTER_MARKETPLACE_APP_ID=
OPENROUTER_API_KEY=
SALESLUMEN_EMAILS_MARKETPLACE_APP_ID=
TRULYINBOX_MARKETPLACE_APP_ID=
TRULYINBOX_API_KEY=
ZAPMAIL_MARKETPLACE_APP_ID=
ZAPMAIL_API_KEY=
